DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/2wayz_dev?schema=public"
PORT=5001
CLIENT_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Server-side Google key (keep private; enable and restrict to Routes API + Geocoding API, and apply your server IP restriction)
GOOGLE_MAPS_SERVER_API_KEY=REPLACE_WITH_SERVER_RESTRICTED_KEY
ADMIN_NAME=2WAYZ Super Admin
ADMIN_EMAIL=admin@2wayz.in
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_SEEDING
COOKIE_SECURE=false

# Scheduled ride dispatch (optional; defaults shown)
SCHEDULED_DISPATCH_LEAD_MINUTES=15
SCHEDULED_DISPATCH_RETRY_SECONDS=60
SCHEDULED_DISPATCH_OFFER_SECONDS=60
SCHEDULED_DISPATCH_MAX_DRIVERS=10
SCHEDULED_DISPATCH_RADIUS_KM=8
