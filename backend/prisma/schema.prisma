generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomePageSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  navLabel    String
  footerLabel String
  content     Json
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PassengerUser {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  ratings      Rating[]
  savedPlaces  PassengerSavedPlace[]
}

model Driver {
  id                String        @id @default(cuid())
  name              String
  phone             String        @unique
  passwordHash      String
  vehicleNumber     String        @unique
  licenceNumber     String
  drivingLicenceExpiryDate DateTime?
  vehicleInsuranceExpiryDate DateTime?
  fcExpiryDate      DateTime?
  age               Int?
  profilePhotoUrl   String?
  complianceNoticeSentAt DateTime?
  serviceArea       String        @default("Tiruvannamalai")
  status            String        @default("PENDING")
  isOnline          Boolean       @default(false)
  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookings          Booking[]
  ratings           Rating[]
  offers            DriverOffer[]
  wallet            DriverWallet?
  walletRecharges   WalletRecharge[]
  subscriptionPayments DriverSubscriptionPayment[]
  subscriptions DriverSubscription[]
  activities        DriverActivity[]
  financialAdjustments BookingAdjustment[]
  @@index([status, isOnline, locationUpdatedAt])
}

model Booking {
  id                 String        @id @default(cuid())
  reference          String        @unique
  passengerId        String
  driverId           String?
  assignedByAdminId  String?
  manuallyAssignedAt DateTime?
  pickupName         String
  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  destinationName    String
  destinationAddress String
  destinationLat     Float
  destinationLng     Float
  distanceKm         Float
  estimatedMinutes   Int
  estimatedFare      Int
  fareBaseAmount     Int?
  fareIncludedDistanceKm Float?
  farePerKmRate      Float?
  fareMinimumAmount  Int?
  fareRoundingIncrement Int?
  mode               String        @default("instant")
  scheduledAt        DateTime?
  status             String        @default("REQUESTED")
  requestedAt        DateTime      @default(now())
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  tripStartedAt      DateTime?
  completedAt        DateTime?
  rideStartOtpHash   String?
  rideStartOtpEncrypted String?
  rideStartOtpAttempts Int @default(0)
  rideStartOtpVerifiedAt DateTime?
  finalFare          Int?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  dispatchStatus     String        @default("SCHEDULED")
  dispatchLastAttemptAt DateTime?
  dispatchAttemptCount Int         @default(0)
  dispatchAlertedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  passenger          PassengerUser @relation(fields: [passengerId], references: [id])
  driver             Driver?       @relation(fields: [driverId], references: [id])
  offers             DriverOffer[]
  financialAdjustments BookingAdjustment[]
  tripShareLink       TripShareLink?
  rating              Rating?
  sosAlerts           SOSAlert[]
  @@index([passengerId, createdAt])
  @@index([driverId, status])
  @@index([status, requestedAt])
  @@index([mode, dispatchStatus, scheduledAt])
}

model DriverOffer {
  id        String   @id @default(cuid())
  bookingId String
  driverId  String
  status    String   @default("OFFERED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@unique([bookingId, driverId])
  @@index([driverId, status, createdAt])
}

model DriverWallet {
  id           String              @id @default(cuid())
  driverId     String              @unique
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  driver       Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletSettings {
  id             String   @id @default("default")
  commissionMode String   @default("PERCENTAGE")
  commissionValue Float   @default(0)
  minimumBalance Int      @default(0)
  isActive       Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model WalletRecharge {
  id               String              @id @default(cuid())
  driverId         String
  amount           Int
  paymentReference String
  proofUrl         String?
  status           String              @default("PENDING")
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  driver           Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transaction      WalletTransaction?
  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
}

model WalletTransaction {
  id            String          @id @default(cuid())
  walletId      String
  type          String
  amount        Int
  settledAmount Int             @default(0)
  commissionMode String?
  commissionValue Float?
  status        String          @default("POSTED")
  description   String
  bookingId     String?         @unique
  rechargeId    String?         @unique
  balanceAfter  Int
  createdAt     DateTime        @default(now())
  wallet        DriverWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  recharge      WalletRecharge? @relation(fields: [rechargeId], references: [id], onDelete: SetNull)
  adjustmentId  String?         @unique
  adjustment    BookingAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  @@index([walletId, createdAt])
  @@index([type, status])
}


model Notification {
  id          String   @id @default(cuid())
  recipientRole String
  recipientId String?
  type        String
  title       String
  message     String
  bookingId   String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  @@index([recipientRole, recipientId, readAt, createdAt])
  @@index([type, createdAt])
}

model DriverActivity {
  id          String   @id @default(cuid())
  driverId    String
  eventType   String
  description String
  bookingId   String?
  createdAt   DateTime @default(now())
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@index([driverId, createdAt])
  @@index([eventType, createdAt])
}

model BookingAdjustment {
  id                 String          @id @default(cuid())
  bookingId          String
  driverId           String
  type               String
  amount             Int
  reason             String
  createdBy          String
  createdAt          DateTime        @default(now())
  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver             Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  walletTransaction  WalletTransaction?
  @@index([bookingId, createdAt])
  @@index([driverId, createdAt])
}


model TripShareLink {
  id        String   @id @default(cuid())
  bookingId String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}


model SOSAlert {
  id                String   @id @default(cuid())
  bookingId         String?
  triggeredByRole   String
  triggeredById     String
  status            String   @default("OPEN")
  latitude          Float?
  longitude         Float?
  locationAccuracy  Float?
  description       String?
  actionTaken       String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  booking           Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([bookingId, createdAt])
  @@index([triggeredByRole, triggeredById, createdAt])
}


model Rating {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  passengerId    String
  driverId       String
  stars          Int
  tags           String[]      @default([])
  comment        String?
  isVisible      Boolean       @default(true)
  moderationNote String?
  hiddenAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passenger      PassengerUser @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  driver         Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@index([driverId, isVisible, createdAt])
  @@index([isVisible, createdAt])
}


model PassengerSavedPlace {
  id          String        @id @default(cuid())
  passengerId String
  category    String
  label       String
  placeId     String?
  name        String
  address     String
  latitude    Float
  longitude   Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  passenger   PassengerUser @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  @@index([passengerId, category, createdAt])
}


model FareSettings {
  id                    String   @id @default("default")
  baseFare              Int      @default(30)
  includedDistanceKm    Float    @default(1)
  perKmRate             Float    @default(18)
  minimumFare           Int      @default(50)
  roundingIncrement     Int      @default(5)
  isActive              Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}



model DriverSubscriptionPlan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  durationDays Int
  price        Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payments     DriverSubscriptionPayment[]
  @@index([isActive, price])
}

model DriverSubscriptionPayment {
  id               String   @id @default(cuid())
  driverId         String
  planId           String
  planName         String
  durationDays     Int
  amount           Int
  paymentMethod    String
  paymentReference String?
  proofUrl         String?
  status           String   @default("PENDING")
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plan             DriverSubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
}

model DriverSubscription {
  id        String   @id @default(cuid())
  driverId  String
  paymentId String   @unique
  planName  String
  amount    Int
  startsAt  DateTime
  expiresAt DateTime
  expiryNoticeSentAt DateTime?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@index([driverId, status, expiresAt])
}
